# LiveKit API Configuration
# Get these from https://cloud.livekit.io/
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your-livekit-api-key"
LIVEKIT_API_SECRET="your-livekit-api-secret"

# LLM Configuration
# We use Gemini 2.5 Flash for the conversational agent and summary generation
# Get your key from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key"

# Speech-to-Text (STT) Configuration
# We use Deepgram Nova 3 General for fast, accurate transcription
# Get your key from https://console.deepgram.com/
DEEPGRAM_API_KEY="your-deepgram-api-key"

# Text-to-Speech (TTS) Configuration
# We use Cartesia Sonic-2 for ultra-realistic voice synthesis
# Get your key from https://play.cartesia.ai/
CARTESIA_API_KEY="your-cartesia-api-key"

# (Optional) Database Path for SQLite
# Defaults to database.sqlite in the root folder if not set
DB_PATH="database.sqlite"

DATABASE_URL=""